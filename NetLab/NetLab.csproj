<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CompressionEnabled>false</CompressionEnabled>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <WasmStripILAfterAOT Condition="'$(Configuration)' == 'Release'">false</WasmStripILAfterAOT>
    <WasmEmitSymbolMap Condition="'$(Configuration)' == 'Release'">true</WasmEmitSymbolMap>
    <SatelliteResourceLanguages Condition="'$(Configuration)' == 'Debug'">en</SatelliteResourceLanguages>
    <WasmDebugLevel Condition="'$(Configuration)' == 'Debug'">1</WasmDebugLevel>
  </PropertyGroup>

  <!-- Mono's WASM interpreter executes the recursive reference IL for this runtime
       intrinsic. Patch only the Debug build's private CoreLib copy so Roslyn emit
       works without disabling the managed debugger through AOT. -->
  <Target Name="BuildCoreLibPatcher" BeforeTargets="PatchDebugCoreLib" Condition="'$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_CoreLibPatcherProject>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', 'tools', 'CoreLibPatcher', 'CoreLibPatcher.csproj'))</_CoreLibPatcherProject>
      <_CoreLibPatcherAssembly>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', 'tools', 'CoreLibPatcher', 'bin', '$(Configuration)', 'net10.0', 'CoreLibPatcher.dll'))</_CoreLibPatcherAssembly>
    </PropertyGroup>
    <MSBuild Projects="$(_CoreLibPatcherProject)" Targets="Build" Properties="Configuration=$(Configuration)" BuildInParallel="false" />
  </Target>

  <Target Name="PatchDebugCoreLib" AfterTargets="ResolveReferences" BeforeTargets="_GatherWasmFilesToBuild;_ResolveWasmOutputs" Condition="'$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_PatchedCoreLibDirectory>$([MSBuild]::NormalizeDirectory('$(IntermediateOutputPath)', 'patched-runtime'))</_PatchedCoreLibDirectory>
      <_PatchedCoreLibPath>$(_PatchedCoreLibDirectory)System.Private.CoreLib.dll</_PatchedCoreLibPath>
    </PropertyGroup>
    <ItemGroup>
      <_OriginalCoreLib Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.FileName)%(ReferenceCopyLocalPaths.Extension)' == 'System.Private.CoreLib.dll'" />
    </ItemGroup>
    <Error Condition="'@(_OriginalCoreLib)' == ''" Text="System.Private.CoreLib.dll was not found in ReferenceCopyLocalPaths." />
    <MakeDir Directories="$(_PatchedCoreLibDirectory)" />
    <Copy SourceFiles="@(_OriginalCoreLib)" DestinationFiles="$(_PatchedCoreLibPath)" />
    <Exec Command="dotnet &quot;$(_CoreLibPatcherAssembly)&quot; &quot;$(_PatchedCoreLibPath)&quot;" />
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(_OriginalCoreLib)" />
      <ReferenceCopyLocalPaths Include="$(_PatchedCoreLibPath)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="ICSharpCode.Decompiler" Version="10.1.0.8386" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" IsImplicitlyDefined="true" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" IsImplicitlyDefined="true" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Features" Version="5.6.0" />
    <PackageReference Include="Mobius.ILasm" Version="0.1.0" />
    <PackageReference Include="System.Security.Permissions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="NetLab" />
    <TrimmerRootAssembly Include="ICSharpCode.Decompiler" />
    <TrimmerRootAssembly Include="System.Runtime" />
    <TrimmerRootAssembly Include="System.Console" />
    <TrimmerRootAssembly Include="System.Text.RegularExpressions" />
    <TrimmerRootAssembly Include="System.Linq" />
    <TrimmerRootAssembly Include="System.Linq.Expressions" />
    <TrimmerRootAssembly Include="System.Net.Primitives" />
    <TrimmerRootAssembly Include="System.Net.Http" />
    <TrimmerRootAssembly Include="System.Private.Uri" />
    <TrimmerRootAssembly Include="System.ComponentModel.Primitives" />
    <TrimmerRootAssembly Include="System.Collections" />
    <TrimmerRootAssembly Include="Microsoft.CSharp" />
    <TrimmerRootAssembly Include="Microsoft.VisualBasic.Core" />
    <TrimmerRootAssembly Include="System.Net.WebClient" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
