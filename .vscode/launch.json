{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "1.0.0",
    "configurations": [
        {
            "name": "C#: NetLab [https]",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/NetLab/NetLab.csproj",
            "launchConfigurationId": "TargetFramework=;https",
            "serverReadyAction": {
                "action": "openWithDebugProxy",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/_framework/debug/ws-proxy?browser={browserInspectUri}",
                "webRoot": "${workspaceFolder}/NetLab/wwwroot"
            }
        },
        {
            "name": "C#: NetLab [http]",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/NetLab/NetLab.csproj",
            "launchConfigurationId": "TargetFramework=;http",
            "serverReadyAction": {
                "action": "openWithDebugProxy",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/_framework/debug/ws-proxy?browser={browserInspectUri}",
                "webRoot": "${workspaceFolder}/NetLab/wwwroot"
            }
        }
    ]
}
